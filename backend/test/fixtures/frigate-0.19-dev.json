{
  "version": "0.19.0-dev",
  "cameras": {
    "cam_masked": {
      "enabled": true,
      "ffmpeg": {
        "inputs": [
          {
            "path": "rtsp://*:*@192.168.1.50:554/stream1",
            "roles": ["record"]
          }
        ]
      },
      "detect": { "width": 640, "height": 360 }
    },
    "cam_disabled": {
      "enabled": false,
      "ffmpeg": {
        "inputs": [
          { "path": "rtsp://127.0.0.1:8554/cam_disabled", "roles": ["record"] }
        ]
      }
    },
    "cam_go2rtc_only": {
      "enabled": true,
      "ffmpeg": { "inputs": [] },
      "detect": { "width": 1280, "height": 720 }
    },
    "cam_profile": {
      "enabled": true,
      "profiles": { "lowres": { "detect": { "width": 320, "height": 180 } } },
      "ffmpeg": {
        "inputs": [
          { "path": "rtsp://127.0.0.1:8554/cam_profile?timeout=20", "roles": ["record", "detect"] }
        ]
      },
      "detect": { "width": 1280, "height": 720 }
    }
  },
  "go2rtc": {
    "streams": {
      "cam_go2rtc_only": [
        "rtsp://192.168.1.60:554/cam?channel=1&subtype=0#timeout=30#backchannel=0",
        "ffmpeg:cam_go2rtc_only#audio=opus"
      ],
      "cam_disabled": ["rtsp://127.0.0.1:8554/cam_disabled"]
    }
  }
}
