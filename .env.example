# RTSP Timelapse Creator Environment Variables
# Copy this file to .env and update with your actual values

# ============================================
# MQTT Configuration (Optional)
# ============================================
# MQTT broker settings for MQTT-triggered captures
# Leave empty if not using MQTT features
MQTT_BROKER_URL=
MQTT_PORT=
MQTT_USERNAME=
MQTT_PASSWORD=

# ============================================
# Frontend Configuration
# ============================================
# Frontend API and WebSocket URLs
# Update these to match your server's hostname or IP address
# Used during frontend build
REACT_APP_API_URL=http://localhost:3001
REACT_APP_WS_URL=ws://localhost:3002

# ============================================
# Frigate Integration (Optional)
# ============================================
# Base URL of the Frigate API. The internal port (5000 inside Docker) needs
# no auth; the public port (8971) needs FRIGATE_API_TOKEN.
#FRIGATE_API_URL=http://frigate:5000
# Host:port that Frigate's go2rtc RTSP restreams are reachable at from
# this container. "frigate:8554" when on the frigate_default network.
#FRIGATE_RTSP_HOST=frigate:8554
# Frigate auth token (JWT) for the public API port. Leave empty when using
# the internal port.
#FRIGATE_API_TOKEN=

# ============================================
# Backend Configuration (Optional)
# ============================================
# Import path for network photo imports
# Default: /mnt/photo_import
IMPORT_PARENT_PATH=/mnt/photo_import

# Backend port (default: 3001)
# PORT=3001

# WebSocket port (default: 3002)
# WS_PORT=3002

# ============================================
# Video Upload (Optional)
# ============================================
# Maximum uploaded video size in MB (default 500)
#VIDEO_UPLOAD_LIMIT_MB=500
